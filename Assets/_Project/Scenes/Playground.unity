          Ch\u1EB7n m\u1ECDi s\xE1t th\u01B0\u01A1ng, k\u1EBB \u0111\u1ECBch ch\u1EA1m
          v\xF2ng ph\xE9p m\u1EA5t m\xE1u."
        cooldown: 6
        duration: 1.5
        tickDamage: 6
        tickInterval: 0.3
        radius: 1.7
        fxScale: 0.7
    - rid: 3955286833755586593
      type: {class: PinkCrystalNova, ns: Octopus, asm: Octopus.Runtime}
      data:
        name: "K\u0129 n\u0103ng \u0111\u1EB7c bi\u1EC7t"
